# Copy to .env and fill in. Without the Supabase values, `npm run dev` opens in demo mode
# (data stays in your browser). A production build refuses to start without them.
# On Vercel, put the same names under Project Settings > Environment Variables instead of a file.

# Browser-safe values: Supabase dashboard > Project Settings > API (Project URL, anon public key).
# If you connect Vercel's Supabase integration, it creates SUPABASE_URL and SUPABASE_ANON_KEY,
# and those work too: then leave these two out.
VITE_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR-ANON-KEY"

# Server-only. Never prefix this with VITE_. It lets the server read the AI key saved from
# Settings. Leave it empty if you prefer to set GEMINI_API_KEY below instead.
SUPABASE_SERVICE_ROLE_KEY=""

# Optional AI CV parsing. Either set the key here or save it in the app under Settings > AI.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"

# Local and self-hosted only; Vercel ignores it.
PORT=3000
