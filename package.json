{
  "name": "bitopi-onboarding-suite",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "postinstall": "node scripts/copy-vendor-assets.mjs",
    "predev": "node scripts/copy-vendor-assets.mjs",
    "prebuild": "node scripts/copy-vendor-assets.mjs",
    "dev": "tsx server/index.ts",
    "build": "vite build && esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-server/index.js",
    "build:web": "node scripts/copy-vendor-assets.mjs && vite build",
    "start": "cross-env NODE_ENV=production node dist-server/index.js",
    "lint": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@google/genai": "^2.4.0",
    "@supabase/supabase-js": "^2.119.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "cross-env": "^7.0.3",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^6.5.438",
    "react-router-dom": "^7.18.5",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.0",
    "lucide-react": "^0.546.0",
    "pdf-lib": "^1.17.1",
    "playwright-core": "^1.64.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.1.0"
  }
}
